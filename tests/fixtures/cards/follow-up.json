{
  "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "fallbackText": "Customer Service Desk: What would you like to do next?. Continue by typing your request.",
  "body": [
    {
      "type": "ColumnSet",
      "spacing": "None",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "TextBlock",
              "text": "Customer",
              "wrap": true,
              "size": "ExtraLarge",
              "isSubtle": false,
              "weight": "Bolder"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "verticalContentAlignment": "Center",
          "items": [
            {
              "type": "TextBlock",
              "text": "SERVICE DESK",
              "wrap": true,
              "size": "Small",
              "isSubtle": false,
              "weight": "Bolder",
              "horizontalAlignment": "Right"
            },
            {
              "type": "TextBlock",
              "text": "Employee support",
              "wrap": true,
              "size": "Small",
              "isSubtle": true,
              "spacing": "None",
              "horizontalAlignment": "Right"
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "What would you like to do next?",
      "wrap": true,
      "size": "Large",
      "isSubtle": false,
      "weight": "Bolder",
      "spacing": "Medium",
      "separator": true
    },
    {
      "type": "TextBlock",
      "text": "Keep working on an issue or check a ticket.",
      "wrap": true,
      "size": "Default",
      "isSubtle": true
    },
    {
      "type": "TextBlock",
      "text": "More to share? Type Feedback: followed by your comments.",
      "wrap": true,
      "size": "Small",
      "isSubtle": true,
      "spacing": "Medium"
    },
    {
      "type": "ActionSet",
      "id": "response-feedback",
      "actions": [
        {
          "type": "Action.Execute",
          "title": "\ud83d\udc4d Helpful",
          "verb": "feedback_like",
          "data": {
            "verb": "feedback_like"
          },
          "associatedInputs": "none",
          "fallback": {
            "type": "Action.Submit",
            "title": "\ud83d\udc4d Helpful",
            "data": {
              "verb": "feedback_like"
            },
            "associatedInputs": "none"
          }
        },
        {
