{
  "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "fallbackText": "Customer Service Desk: Knowledge search results. Continue by typing your request.",
  "body": [
    {
      "type": "ColumnSet",
      "spacing": "None",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "TextBlock",
              "text": "Customer",
              "wrap": true,
              "size": "ExtraLarge",
              "isSubtle": false,
              "weight": "Bolder"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "verticalContentAlignment": "Center",
          "items": [
            {
              "type": "TextBlock",
              "text": "SERVICE DESK",
              "wrap": true,
              "size": "Small",
              "isSubtle": false,
              "weight": "Bolder",
              "horizontalAlignment": "Right"
            },
            {
              "type": "TextBlock",
              "text": "Employee support",
              "wrap": true,
              "size": "Small",
              "isSubtle": true,
              "spacing": "None",
              "horizontalAlignment": "Right"
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Knowledge search results",
      "wrap": true,
      "size": "Large",
      "isSubtle": false,
      "weight": "Bolder",
      "spacing": "Medium",
      "separator": true
    },
    {
      "type": "TextBlock",
      "text": "Search: printer",
      "wrap": true,
      "size": "Default",
      "isSubtle": true
    },
    {
      "type": "TextBlock",
      "text": "KB0001 \u2014 Printer checks",
      "wrap": true,
      "size": "Default",
      "isSubtle": false,
      "weight": "Bolder"
    },
    {
      "type": "TextBlock",
      "text": "Check the selected printer.",
      "wrap": true,
      "size": "Small",
      "isSubtle": false
    },
    {
      "type": "ActionSet",
      "actions": [
        {
          "type": "Action.OpenUrl",
          "title": "Open article in ServiceNow",
          "url": "https://mock.service-now.com/kb_view.do?sys_kb_id=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "More to share? Type Feedback: followed by your comments.",
      "wrap": true,
      "size": "Small",
      "isSubtle": true,
      "spacing": "Medium"
    },
    {
      "type": "ActionSet",
      "id": "response-feedback",
      "actions": [
        {
          "type": "Action.Execute",
          "title": "\ud83d\udc4d Helpful",
          "verb": "feedback_like",
          "data": {
            "verb": "feedback_like"
          },
          "associatedInputs": "none",
          "fallback": {
            "type": "Action.Submit",
            "title": "\ud83d\udc4d Helpful",
            "data": {
              "verb": "feedback_like"
            },
            "associatedInputs": "none"
          }
        },
        {
          "type": "Action.Execute",
          "title": "\ud83d\udc4e Not helpful",
          "verb": "feedback_dislike",
          "data": {
            "verb": "feedback_dislike"
          },
          "associatedInputs": "none",
          "fallback": {
            "type": "Action.Submit",
            "title": "\ud83d\udc4e Not helpful",
            "data": {
              "verb": "feedback_dislike"
            },
            "associatedInputs": "none"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "Search again",
      "verb": "kb_form",
      "data": {
        "verb": "kb_form"
      },
      "associatedInputs": "none",
      "fallback": {
        "type": "Action.Submit",
        "title": "Search again",
        "data": {
          "verb": "kb_form"
        },
        "associatedInputs": "none"
      }
    }
  ]
}
