    },
    {
      "type": "TextBlock",
      "text": "Comment INC0012345",
      "wrap": true,
      "size": "Medium"
    },
    {
      "type": "TextBlock",
      "text": "Nothing has been changed. Review exactly what will be sent.",
      "wrap": true,
      "size": "Default",
      "isSubtle": true
    },
    {
      "type": "TextBlock",
      "text": "COMMENTS",
      "wrap": true,
      "size": "Small",
      "isSubtle": true
    },
    {
      "type": "TextBlock",
      "text": "A test page failed.",
      "wrap": true,
      "size": "Default"
    },
    {
      "type": "TextBlock",
      "text": "This review expires after a short period. Confirm only once.",
      "wrap": true,
      "size": "Default",
      "isSubtle": true
    }
  ],
