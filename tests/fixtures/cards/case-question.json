{
  "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "fallbackText": "Customer Service Desk: Email troubleshooting. Continue by typing your request.",
  "body": [
    {
      "type": "ColumnSet",
      "spacing": "None",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "Image",
              "url": "data:image/png;base64,",
              "altText": "Customer",
              "width": "168px",
              "height": "56px",
              "backgroundColor": "#FFFFFF"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "verticalContentAlignment": "Center",
          "items": [
            {
              "type": "TextBlock",
              "text": "SERVICE DESK",
              "wrap": true,
              "size": "Small",
              "weight": "Bolder",
              "horizontalAlignment": "Right"
            },
            {
              "type": "TextBlock",
              "text": "Employee support",
              "wrap": true,
              "size": "Small",
              "isSubtle": true,
              "spacing": "None",
              "horizontalAlignment": "Right"
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Email troubleshooting",
      "wrap": true,
      "size": "Large",
      "weight": "Bolder",
      "spacing": "Medium",
      "separator": true
    },
    {
      "type": "TextBlock",
      "text": "What error does Outlook show?",
      "wrap": true,
      "size": "Default"
    },
    {
      "type": "Input.Text",
      "id": "case_answer",
      "label": "Your answer",
      "isRequired": true,
      "errorMessage": "Enter an answer, or choose I don't know.",
      "maxLength": 2000,
      "isMultiline": true
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "Continue",
      "verb": "case_answer",
      "data": {
        "verb": "case_answer",
        "case_token": "dddddddddddddddddddddddddddddddd"
      },
      "associatedInputs": "auto",
      "fallback": {
        "type": "Action.Submit",
        "title": "Continue",
        "data": {
          "verb": "case_answer",
          "case_token": "dddddddddddddddddddddddddddddddd"
        },
        "associatedInputs": "auto"
      }
    },
    {
      "type": "Action.Execute",
      "title": "I don't know",
      "verb": "case_unknown",
      "data": {
        "verb": "case_unknown",
        "case_token": "dddddddddddddddddddddddddddddddd"
      },
      "associatedInputs": "none",
      "fallback": {
        "type": "Action.Submit",
        "title": "I don't know",
        "data": {
          "verb": "case_unknown",
          "case_token": "dddddddddddddddddddddddddddddddd"
        },
        "associatedInputs": "none"
      }
    }
  ]
}
