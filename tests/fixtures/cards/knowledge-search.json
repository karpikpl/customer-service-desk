{
  "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "fallbackText": "Customer Service Desk: Search approved knowledge. Continue by typing your request.",
  "body": [
    {
      "type": "ColumnSet",
      "spacing": "None",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "TextBlock",
              "text": "Customer",
              "wrap": true,
              "size": "ExtraLarge",
              "isSubtle": false,
              "weight": "Bolder"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "verticalContentAlignment": "Center",
          "items": [
            {
              "type": "TextBlock",
              "text": "SERVICE DESK",
              "wrap": true,
              "size": "Small",
              "isSubtle": false,
              "weight": "Bolder",
              "horizontalAlignment": "Right"
            },
            {
              "type": "TextBlock",
              "text": "Employee support",
              "wrap": true,
              "size": "Small",
              "isSubtle": true,
              "spacing": "None",
              "horizontalAlignment": "Right"
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Search approved knowledge",
      "wrap": true,
      "size": "Large",
      "isSubtle": false,
      "weight": "Bolder",
      "spacing": "Medium",
      "separator": true
    },
    {
      "type": "TextBlock",
      "text": "Search published articles approved for employee access.",
      "wrap": true,
      "size": "Default",
      "isSubtle": true
    },
    {
      "type": "Input.Text",
      "id": "kb_query",
      "label": "Search words",
      "isMultiline": false,
      "isRequired": true,
      "errorMessage": "Please complete this field.",
      "maxLength": 120,
      "value": ""
    },
    {
      "type": "TextBlock",
      "text": "More to share? Type Feedback: followed by your comments.",
      "wrap": true,
      "size": "Small",
      "isSubtle": true,
      "spacing": "Medium"
    },
    {
      "type": "ActionSet",
      "id": "response-feedback",
      "actions": [
        {
          "type": "Action.Execute",
          "title": "\ud83d\udc4d Helpful",
          "verb": "feedback_like",
          "data": {
            "verb": "feedback_like"
          },
          "associatedInputs": "none",
          "fallback": {
            "type": "Action.Submit",
            "title": "\ud83d\udc4d Helpful",
            "data": {
              "verb": "feedback_like"
            },
            "associatedInputs": "none"
          }
        },
        {
          "type": "Action.Execute",
          "title": "\ud83d\udc4e Not helpful",
          "verb": "feedback_dislike",
          "data": {
            "verb": "feedback_dislike"
          },
          "associatedInputs": "none",
          "fallback": {
            "type": "Action.Submit",
            "title": "\ud83d\udc4e Not helpful",
            "data": {
              "verb": "feedback_dislike"
            },
            "associatedInputs": "none"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "Search",
      "verb": "kb_search",
      "data": {
        "verb": "kb_search"
      },
      "associatedInputs": "auto",
      "fallback": {
        "type": "Action.Submit",
        "title": "Search",
        "data": {
          "verb": "kb_search"
        },
        "associatedInputs": "auto"
      }
    },
    {
      "type": "Action.Execute",
      "title": "Cancel",
      "verb": "home",
      "data": {
        "verb": "home"
      },
      "associatedInputs": "none",
      "fallback": {
        "type": "Action.Submit",
        "title": "Cancel",
        "data": {
          "verb": "home"
        },
        "associatedInputs": "none"
      }
    }
  ]
}
