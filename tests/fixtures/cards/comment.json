{
  "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "fallbackText": "Customer Service Desk: Comment on INC0012345. Continue by typing your request.",
  "body": [
    {
      "type": "ColumnSet",
      "spacing": "None",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "Image",
              "url": "data:image/png;base64,",
              "altText": "Customer",
              "width": "168px",
              "height": "56px",
              "backgroundColor": "#FFFFFF"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "verticalContentAlignment": "Center",
          "items": [
            {
              "type": "TextBlock",
              "text": "SERVICE DESK",
              "wrap": true,
              "size": "Small",
              "weight": "Bolder",
              "horizontalAlignment": "Right"
            },
            {
              "type": "TextBlock",
              "text": "Employee support",
              "wrap": true,
              "size": "Small",
              "isSubtle": true,
              "spacing": "None",
              "horizontalAlignment": "Right"
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Comment on INC0012345",
      "wrap": true,
      "size": "Large",
      "weight": "Bolder",
      "spacing": "Medium",
      "separator": true
    },
    {
      "type": "Input.Text",
      "id": "comment",
      "label": "Customer-visible comment",
      "isMultiline": true,
      "isRequired": true,
      "errorMessage": "Please complete this field.",
      "maxLength": 4000,
      "value": ""
    },
    {
      "type": "TextBlock",
      "text": "Next, review exactly what will be sent. Nothing changes until you confirm.",
      "wrap": true,
      "size": "Small",
      "isSubtle": true
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "Review comment",
      "verb": "prepare_comment",
      "data": {
        "verb": "prepare_comment",
        "incident": "INC0012345",
        "action_id": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
        "scope_token": ""
      },
      "associatedInputs": "auto",
      "fallback": {
        "type": "Action.Submit",
        "title": "Review comment",
        "data": {
          "verb": "prepare_comment",
          "incident": "INC0012345",
          "action_id": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
          "scope_token": ""
        },
        "associatedInputs": "auto"
      }
    },
    {
      "type": "Action.Execute",
      "title": "Cancel",
      "verb": "view",
      "data": {
        "verb": "view",
        "incident": "INC0012345"
      },
      "associatedInputs": "none",
      "fallback": {
        "type": "Action.Submit",
        "title": "Cancel",
        "data": {
          "verb": "view",
          "incident": "INC0012345"
        },
        "associatedInputs": "none"
      }
    }
  ]
}
