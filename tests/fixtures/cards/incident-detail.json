{
  "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "fallbackText": "Customer Service Desk: INC0012345. Continue by typing your request. Incident in ServiceNow: https://mock.service-now.com/sp?id=ticket&table=incident&sys_id=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "body": [
    {
      "type": "ColumnSet",
      "spacing": "None",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "Image",
              "url": "data:image/png;base64,",
              "altText": "Customer",
              "width": "168px",
              "height": "56px",
              "backgroundColor": "#FFFFFF"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "verticalContentAlignment": "Center",
          "items": [
            {
              "type": "TextBlock",
              "text": "SERVICE DESK",
              "wrap": true,
              "size": "Small",
              "weight": "Bolder",
              "horizontalAlignment": "Right"
            },
            {
              "type": "TextBlock",
              "text": "Employee support",
              "wrap": true,
              "size": "Small",
              "isSubtle": true,
              "spacing": "None",
              "horizontalAlignment": "Right"
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "INC0012345",
      "wrap": true,
      "size": "Large",
      "weight": "Bolder",
      "spacing": "Medium",
      "separator": true
    },
    {
      "type": "TextBlock",
      "text": "Printer unavailable on Floor 2",
      "wrap": true,
      "size": "Medium",
      "weight": "Bolder"
    },
    {
      "type": "FactSet",
      "facts": [
        {
          "title": "Status",
          "value": "In progress"
        },
        {
          "title": "Priority",
          "value": "3 - Moderate"
        },
        {
          "title": "Updated",
          "value": "2026-01-01 10:00:00 UTC"
        }
      ]
    },
    {
      "type": "Container",
      "style": "emphasis",
      "items": [
        {
          "type": "TextBlock",
          "text": "LATEST CUSTOMER UPDATE",
          "wrap": true,
          "size": "Small",
          "isSubtle": true
        },
        {
          "type": "TextBlock",
          "text": "The service desk is investigating.",
          "wrap": true,
          "size": "Default"
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "DESCRIPTION",
      "wrap": true,
      "size": "Small",
      "isSubtle": true
    },
    {
      "type": "TextBlock",
      "text": "The shared printer appears offline. A test page did not print.",
      "wrap": true,
      "size": "Default"
    },
    {
      "type": "ActionSet",
      "spacing": "Medium",
      "actions": [
        {
          "type": "Action.Execute",
          "title": "Troubleshoot this issue",
          "verb": "troubleshoot",
          "data": {
            "verb": "troubleshoot",
            "incident": "INC0012345"
          },
          "associatedInputs": "none",
          "fallback": {
            "type": "Action.Submit",
            "title": "Troubleshoot this issue",
            "data": {
              "verb": "troubleshoot",
              "incident": "INC0012345"
            },
            "associatedInputs": "none"
          }
        },
        {
          "type": "Action.Execute",
          "title": "My incidents",
          "verb": "list",
          "data": {
            "verb": "list"
          },
          "associatedInputs": "none",
          "fallback": {
            "type": "Action.Submit",
            "title": "My incidents",
            "data": {
              "verb": "list"
            },
            "associatedInputs": "none"
          }
        }
      ]
    },
    {
      "type": "ActionSet",
      "id": "service-now-incident",
      "separator": true,
      "spacing": "Medium",
      "actions": [
        {
          "type": "Action.OpenUrl",
          "title": "View incident in ServiceNow",
          "url": "https://mock.service-now.com/sp?id=ticket&table=incident&sys_id=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "Add comment",
      "verb": "comment_form",
      "data": {
        "verb": "comment_form",
        "incident": "INC0012345"
      },
      "associatedInputs": "none",
      "fallback": {
        "type": "Action.Submit",
        "title": "Add comment",
        "data": {
          "verb": "comment_form",
          "incident": "INC0012345"
        },
        "associatedInputs": "none"
      }
    },
    {
      "type": "Action.Execute",
      "title": "Resolve",
      "verb": "resolve_form",
      "data": {
        "verb": "resolve_form",
        "incident": "INC0012345"
      },
      "associatedInputs": "none",
      "fallback": {
        "type": "Action.Submit",
        "title": "Resolve",
        "data": {
          "verb": "resolve_form",
          "incident": "INC0012345"
        },
        "associatedInputs": "none"
      }
    },
    {
      "type": "Action.Execute",
      "title": "Refresh",
      "verb": "view",
      "data": {
        "verb": "view",
        "incident": "INC0012345"
      },
      "associatedInputs": "none",
      "fallback": {
        "type": "Action.Submit",
        "title": "Refresh",
        "data": {
          "verb": "view",
          "incident": "INC0012345"
        },
        "associatedInputs": "none"
      }
    }
  ]
}
