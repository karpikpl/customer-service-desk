{
  "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "fallbackText": "Customer Service Desk: Report an issue. Continue by typing your request.",
  "body": [
    {
      "type": "ColumnSet",
      "spacing": "None",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "Image",
              "url": "data:image/png;base64,",
              "altText": "Customer",
              "width": "168px",
              "height": "56px",
              "backgroundColor": "#FFFFFF"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "verticalContentAlignment": "Center",
          "items": [
            {
              "type": "TextBlock",
              "text": "SERVICE DESK",
              "wrap": true,
              "size": "Small",
              "weight": "Bolder",
              "horizontalAlignment": "Right"
            },
            {
              "type": "TextBlock",
              "text": "Employee support",
              "wrap": true,
              "size": "Small",
              "isSubtle": true,
              "spacing": "None",
              "horizontalAlignment": "Right"
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Report an issue",
      "wrap": true,
      "size": "Large",
      "weight": "Bolder",
      "spacing": "Medium",
      "separator": true
    },
    {
      "type": "TextBlock",
      "text": "Capture the issue in one form. Known details are filled in for you.",
      "wrap": true,
      "size": "Default",
      "isSubtle": true
    },
    {
      "type": "Input.Text",
      "id": "title",
      "label": "Issue title",
      "isMultiline": false,
      "isRequired": true,
      "errorMessage": "Please complete this field.",
      "maxLength": 160,
      "value": ""
    },
    {
      "type": "Input.Text",
      "id": "description",
      "label": "What happened?",
      "isMultiline": true,
      "isRequired": true,
      "errorMessage": "Please complete this field.",
      "maxLength": 4000,
      "value": ""
    },
    {
      "type": "Input.ChoiceSet",
      "id": "classification",
      "label": "Category / subcategory",
      "isRequired": true,
      "errorMessage": "Choose category / subcategory.",
      "value": "",
      "choices": [
        {
          "title": "Hardware",
          "value": "hardware"
        },
        {
          "title": "Software / Email",
          "value": "software:email"
        }
      ]
    },
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "Input.ChoiceSet",
              "id": "impact",
              "label": "Impact",
              "isRequired": true,
              "errorMessage": "Choose impact.",
              "value": "",
              "choices": [
                {
                  "title": "Low - one person",
                  "value": "3"
                },
                {
                  "title": "Medium - team",
                  "value": "2"
                },
                {
                  "title": "High - widespread",
                  "value": "1"
                }
              ]
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "Input.ChoiceSet",
              "id": "urgency",
              "label": "Urgency",
              "isRequired": true,
              "errorMessage": "Choose urgency.",
              "value": "",
              "choices": [
                {
                  "title": "Low - can continue working",
                  "value": "3"
                },
                {
                  "title": "Medium - workaround available",
                  "value": "2"
                },
                {
                  "title": "High - blocked, no workaround",
                  "value": "1"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "ActionSet",
      "actions": [
        {
          "type": "Action.ToggleVisibility",
          "title": "Additional context (optional)",
          "targetElements": [
            "incident-context"
          ]
        }
      ]
    },
    {
      "type": "Container",
      "id": "incident-context",
      "isVisible": false,
      "items": [
        {
          "type": "Input.Text",
          "id": "reported_location",
          "label": "Reported location",
          "isMultiline": false,
          "isRequired": false,
          "errorMessage": "Please complete this field.",
          "maxLength": 160,
          "value": ""
        },
        {
          "type": "Input.Text",
          "id": "device",
          "label": "Device / printer",
          "isMultiline": false,
          "isRequired": false,
          "errorMessage": "Please complete this field.",
          "maxLength": 160,
          "value": ""
        },
        {
          "type": "Input.Text",
          "id": "business_impact",
          "label": "How is work affected?",
          "isMultiline": true,
          "isRequired": false,
          "errorMessage": "Please complete this field.",
          "maxLength": 500,
          "value": ""
        },
        {
          "type": "Input.Text",
          "id": "attempted_steps",
          "label": "What have you already tried?",
          "isMultiline": true,
          "isRequired": false,
          "errorMessage": "Please complete this field.",
          "maxLength": 1000,
          "value": ""
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Next, review exactly what will be sent. Nothing changes until you confirm.",
      "wrap": true,
      "size": "Small",
      "isSubtle": true
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "Review incident",
      "verb": "prepare_create",
      "data": {
        "verb": "prepare_create",
        "action_id": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
        "scope_token": ""
      },
      "associatedInputs": "auto",
      "fallback": {
        "type": "Action.Submit",
        "title": "Review incident",
        "data": {
          "verb": "prepare_create",
          "action_id": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
          "scope_token": ""
        },
        "associatedInputs": "auto"
      }
    },
    {
      "type": "Action.Execute",
      "title": "Cancel",
      "verb": "home",
      "data": {
        "verb": "home"
      },
      "associatedInputs": "none",
      "fallback": {
        "type": "Action.Submit",
        "title": "Cancel",
        "data": {
          "verb": "home"
        },
        "associatedInputs": "none"
      }
    }
  ]
}
