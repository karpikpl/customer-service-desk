{
  "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "fallbackText": "Customer Service Desk: Change confirmed. Continue by typing your request. Incident in ServiceNow: https://mock.service-now.com/sp?id=ticket&table=incident&sys_id=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "body": [
    {
      "type": "ColumnSet",
      "spacing": "None",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "Image",
              "url": "data:image/png;base64,",
              "altText": "Customer",
              "width": "168px",
              "height": "56px",
              "backgroundColor": "#FFFFFF"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "verticalContentAlignment": "Center",
          "items": [
            {
              "type": "TextBlock",
              "text": "SERVICE DESK",
              "wrap": true,
              "size": "Small",
              "weight": "Bolder",
              "horizontalAlignment": "Right"
            },
            {
              "type": "TextBlock",
              "text": "Employee support",
              "wrap": true,
              "size": "Small",
              "isSubtle": true,
              "spacing": "None",
              "horizontalAlignment": "Right"
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Change confirmed",
      "wrap": true,
      "size": "Large",
      "weight": "Bolder",
      "spacing": "Medium",
      "separator": true
    },
    {
      "type": "TextBlock",
      "text": "INC0012345",
      "wrap": true,
      "size": "Medium"
    },
    {
      "type": "TextBlock",
      "text": "Printer unavailable on Floor 2",
      "wrap": true,
      "size": "Default"
    },
    {
      "type": "TextBlock",
      "text": "ServiceNow status: In progress",
      "wrap": true,
      "size": "Default",
      "isSubtle": true
    },
    {
      "type": "ActionSet",
      "id": "service-now-incident",
      "separator": true,
      "spacing": "Medium",
      "actions": [
        {
          "type": "Action.OpenUrl",
          "title": "View incident in ServiceNow",
          "url": "https://mock.service-now.com/sp?id=ticket&table=incident&sys_id=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "View incident",
      "verb": "view",
      "data": {
        "verb": "view",
        "incident": "INC0012345"
      },
      "associatedInputs": "none",
      "fallback": {
        "type": "Action.Submit",
        "title": "View incident",
        "data": {
          "verb": "view",
          "incident": "INC0012345"
        },
        "associatedInputs": "none"
      }
    },
    {
      "type": "Action.Execute",
      "title": "My incidents",
      "verb": "list",
      "data": {
        "verb": "list"
      },
      "associatedInputs": "none",
      "fallback": {
        "type": "Action.Submit",
        "title": "My incidents",
        "data": {
          "verb": "list"
        },
        "associatedInputs": "none"
      }
    }
  ]
}
