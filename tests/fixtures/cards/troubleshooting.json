{
  "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "fallbackText": "Customer Service Desk: Printing / Check the selected printer. Continue by typing your request.",
  "body": [
    {
      "type": "ColumnSet",
      "spacing": "None",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "Image",
              "url": "data:image/png;base64,",
              "altText": "Customer",
              "width": "168px",
              "height": "56px",
              "backgroundColor": "#FFFFFF"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "verticalContentAlignment": "Center",
          "items": [
            {
              "type": "TextBlock",
              "text": "SERVICE DESK",
              "wrap": true,
              "size": "Small",
              "weight": "Bolder",
              "horizontalAlignment": "Right"
            },
            {
              "type": "TextBlock",
              "text": "Employee support",
              "wrap": true,
              "size": "Small",
              "isSubtle": true,
              "spacing": "None",
              "horizontalAlignment": "Right"
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Printing / Check the selected printer",
      "wrap": true,
      "size": "Large",
      "weight": "Bolder",
      "spacing": "Medium",
      "separator": true
    },
    {
      "type": "TextBlock",
      "text": "Confirm that the intended printer is selected. Did that solve the problem?",
      "wrap": true,
      "size": "Default"
    },
    {
      "type": "TextBlock",
      "text": "Source: printer-troubleshooting",
      "wrap": true,
      "size": "Small",
      "isSubtle": true
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "That worked",
      "verb": "case_worked",
      "data": {
        "verb": "case_worked",
        "case_token": ""
      },
      "associatedInputs": "none",
      "fallback": {
        "type": "Action.Submit",
        "title": "That worked",
        "data": {
          "verb": "case_worked",
          "case_token": ""
        },
        "associatedInputs": "none"
      }
    },
    {
      "type": "Action.Execute",
      "title": "Still not working",
      "verb": "case_failed",
      "data": {
        "verb": "case_failed",
        "case_token": ""
      },
      "associatedInputs": "none",
      "fallback": {
        "type": "Action.Submit",
        "title": "Still not working",
        "data": {
          "verb": "case_failed",
          "case_token": ""
        },
        "associatedInputs": "none"
      }
    },
    {
      "type": "Action.Execute",
      "title": "Create incident",
      "verb": "case_intake",
      "data": {
        "verb": "case_intake",
        "case_token": ""
      },
      "associatedInputs": "none",
      "fallback": {
        "type": "Action.Submit",
        "title": "Create incident",
        "data": {
          "verb": "case_intake",
          "case_token": ""
        },
        "associatedInputs": "none"
      }
    }
  ]
}
