{
  "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "fallbackText": "Customer Service Desk: Provide feedback. Continue by typing your request.",
  "body": [
    {
      "type": "ColumnSet",
      "spacing": "None",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "Image",
              "url": "data:image/png;base64,",
              "altText": "Customer",
              "width": "168px",
              "height": "56px",
              "backgroundColor": "#FFFFFF"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "verticalContentAlignment": "Center",
          "items": [
            {
              "type": "TextBlock",
              "text": "SERVICE DESK",
              "wrap": true,
              "size": "Small",
              "weight": "Bolder",
              "horizontalAlignment": "Right"
            },
            {
              "type": "TextBlock",
              "text": "Employee support",
              "wrap": true,
              "size": "Small",
              "isSubtle": true,
              "spacing": "None",
              "horizontalAlignment": "Right"
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Provide feedback",
      "wrap": true,
      "size": "Large",
      "weight": "Bolder",
      "spacing": "Medium",
      "separator": true
    },
    {
      "type": "TextBlock",
      "text": "Feedback goes to Application Insights, not ServiceNow. Do not include passwords or unnecessary personal details.",
      "wrap": true,
      "size": "Default",
      "isSubtle": true
    },
    {
      "type": "Input.Text",
      "id": "feedback_text",
      "label": "Your feedback",
      "isMultiline": true,
      "isRequired": true,
      "errorMessage": "Please complete this field.",
      "maxLength": 4000,
      "value": ""
    },
    {
      "type": "Input.ChoiceSet",
      "id": "feedback_rating",
      "label": "Rating",
      "value": "neutral",
      "choices": [
        {
          "title": "Positive",
          "value": "positive"
        },
        {
          "title": "Negative",
          "value": "negative"
        },
        {
          "title": "Suggestion / neutral",
          "value": "neutral"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "Submit feedback",
      "verb": "feedback_submit",
      "data": {
        "verb": "feedback_submit",
        "feedback_response_id": "synthetic-response"
      },
      "associatedInputs": "auto",
      "fallback": {
        "type": "Action.Submit",
        "title": "Submit feedback",
        "data": {
          "verb": "feedback_submit",
          "feedback_response_id": "synthetic-response"
        },
        "associatedInputs": "auto"
      }
    },
    {
      "type": "Action.Execute",
      "title": "Cancel",
      "verb": "home",
      "data": {
        "verb": "home"
      },
      "associatedInputs": "none",
      "fallback": {
        "type": "Action.Submit",
        "title": "Cancel",
        "data": {
          "verb": "home"
        },
        "associatedInputs": "none"
      }
    }
  ]
}
