{
  "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "fallbackText": "Customer Service Desk: Your identity. Continue by typing your request.",
  "body": [
    {
      "type": "ColumnSet",
      "spacing": "None",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "Image",
              "url": "data:image/png;base64,",
              "altText": "Customer",
              "width": "168px",
              "height": "56px",
              "backgroundColor": "#FFFFFF"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "verticalContentAlignment": "Center",
          "items": [
            {
              "type": "TextBlock",
              "text": "SERVICE DESK",
              "wrap": true,
              "size": "Small",
              "weight": "Bolder",
              "horizontalAlignment": "Right"
            },
            {
              "type": "TextBlock",
              "text": "Employee support",
              "wrap": true,
              "size": "Small",
              "isSubtle": true,
              "spacing": "None",
              "horizontalAlignment": "Right"
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Your identity",
      "wrap": true,
      "size": "Large",
      "weight": "Bolder",
      "spacing": "Medium",
      "separator": true
    },
    {
      "type": "FactSet",
      "facts": [
        {
          "title": "Teams name",
          "value": "Synthetic Test User"
        },
        {
          "title": "Entra user ID",
          "value": "00000000-0000-0000-0000-000000000002"
        },
        {
          "title": "Tenant ID",
          "value": "00000000-0000-0000-0000-000000000001"
        },
        {
          "title": "ServiceNow caller ID",
          "value": "11111111111111111111111111111111"
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Identity comes from your authenticated Teams account. The ServiceNow caller is a temporary mock mapping, not browser SSO.",
      "wrap": true,
      "size": "Default",
      "isSubtle": true
    }
  ],
  "actions": []
}
