{
  "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "fallbackText": "Customer Service Desk: Your identity. Continue by typing your request.",
  "body": [
    {
      "type": "ColumnSet",
      "spacing": "None",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "TextBlock",
              "text": "Customer",
              "wrap": true,
              "size": "ExtraLarge",
              "isSubtle": false,
              "weight": "Bolder"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "verticalContentAlignment": "Center",
          "items": [
            {
              "type": "TextBlock",
              "text": "SERVICE DESK",
              "wrap": true,
              "size": "Small",
              "isSubtle": false,
              "weight": "Bolder",
              "horizontalAlignment": "Right"
            },
            {
              "type": "TextBlock",
              "text": "Employee support",
              "wrap": true,
              "size": "Small",
              "isSubtle": true,
              "spacing": "None",
              "horizontalAlignment": "Right"
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Your identity",
      "wrap": true,
      "size": "Large",
      "isSubtle": false,
      "weight": "Bolder",
      "spacing": "Medium",
      "separator": true
    },
    {
      "type": "FactSet",
      "facts": [
        {
          "title": "Teams name",
          "value": "Synthetic Test User"
        },
        {
          "title": "Entra user ID",
          "value": "00000000-0000-0000-0000-000000000002"
        },
        {
          "title": "Tenant ID",
          "value": "00000000-0000-0000-0000-000000000001"
        },
        {
          "title": "ServiceNow caller ID",
          "value": "11111111111111111111111111111111"
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Identity comes from your authenticated Teams account. The ServiceNow caller is a temporary mock mapping, not browser SSO.",
      "wrap": true,
      "size": "Default",
      "isSubtle": true
    },
    {
      "type": "TextBlock",
      "text": "More to share? Type Feedback: followed by your comments.",
      "wrap": true,
      "size": "Small",
      "isSubtle": true,
      "spacing": "Medium"
    },
    {
      "type": "ActionSet",
      "id": "response-feedback",
      "actions": [
        {
          "type": "Action.Execute",
          "title": "\ud83d\udc4d Helpful",
          "verb": "feedback_like",
          "data": {
            "verb": "feedback_like"
          },
          "associatedInputs": "none",
          "fallback": {
            "type": "Action.Submit",
            "title": "\ud83d\udc4d Helpful",
            "data": {
              "verb": "feedback_like"
            },
            "associatedInputs": "none"
          }
        },
        {
          "type": "Action.Execute",
          "title": "\ud83d\udc4e Not helpful",
          "verb": "feedback_dislike",
          "data": {
            "verb": "feedback_dislike"
          },
          "associatedInputs": "none",
          "fallback": {
            "type": "Action.Submit",
            "title": "\ud83d\udc4e Not helpful",
            "data": {
              "verb": "feedback_dislike"
            },
            "associatedInputs": "none"
          }
        }
      ]
    }
  ],
  "actions": []
}
