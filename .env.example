# No passwords or actual identity mappings belong here.
FOUNDRY_PROJECT_ENDPOINT=https://ACCOUNT.services.ai.azure.com/api/projects/PROJECT
AZURE_AI_MODEL_DEPLOYMENT_NAME=YOUR_EXISTING_MODEL_DEPLOYMENT
TOOLBOX_ENDPOINT=https://ACCOUNT.services.ai.azure.com/api/projects/PROJECT/toolboxes/customer-service-desk/mcp?api-version=v1
DESK_TENANT_ID=00000000-0000-0000-0000-000000000001
DESK_SNOW_URL=https://INSTANCE.service-now.com
DESK_SNOW_PORTAL_PATH=/sp
# Safe default: show the exact write review before committing.
# false: explicit form submissions / requested updates commit without a separate review.
DESK_REQUIRE_WRITE_CONFIRMATION=true
# Keep these stable when changing visible branding to preserve cases and model sessions.
DESK_STATE_STORE_NAME=customer-service-desk-v1
DESK_SESSION_DIRECTORY=.customer-service-desk
# Existing Application Insights connection string; configure securely in azd.
# Dedicated feedback exporter only (does not enable global request/body collection).
DESK_FEEDBACK_CONNECTION_STRING=
DESK_KEY_VAULT_URL=https://YOUR-EXISTING-VAULT.vault.azure.net
# Only for local configuration/unit tests; real ticket access remains hosted-only.
# DESK_LOCAL_CONFIG_FILE=local-secrets/config.json
